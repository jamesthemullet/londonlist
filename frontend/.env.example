# Backend URL (Strapi instance) — used in getServerSideProps and API routes
STRAPI_URL=http://localhost:1337

# Public site URL — used in canonical tags, OG images, sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiliate partner IDs (optional — booking links are shown without IDs, but revenue tracking requires them)
# Register at https://restaurant.opentable.co.uk/affiliate and https://www.booking.com/affiliateprogram/
# and https://www.viator.com/partner
NEXT_PUBLIC_OPENTABLE_AFFILIATE_ID=
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
NEXT_PUBLIC_VIATOR_AFFILIATE_ID=
